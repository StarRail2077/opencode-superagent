{
  "name": "opencode-superagent",
  "version": "0.1.0",
  "description": "Router/Worker superagent with an independent, manually controlled Watchdog for OpenCode Desktop",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/server/index.js",
    "./rpc": "./dist/rpc.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "agents",
    "dist",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:gui": "vite build",
    "build": "npm run clean && npm run build:server && npm run build:gui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:server",
    "test": "node --test tests/*.test.mjs",
    "install:local": "node scripts/install.mjs",
    "package:release": "node scripts/package.mjs",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
